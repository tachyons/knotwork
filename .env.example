# Knotwork configuration. Copy to .env and load it with your process manager;
# the binary reads the environment only and never parses this file itself.
# Every variable is prefixed with KNOTWORK_.

KNOTWORK_ADDR=:8080
KNOTWORK_BASE_URL=http://localhost:8080
KNOTWORK_DATABASE_URL=sqlite://./data/knotwork.db
KNOTWORK_DATA_DIR=./data
KNOTWORK_REPO_ROOT=./data/repos
KNOTWORK_SOCKET_PATH=/tmp/knotwork-internal.sock

# OIDC (required for logins; partial configuration fails startup)
KNOTWORK_OIDC_ISSUER=
KNOTWORK_OIDC_CLIENT_ID=
KNOTWORK_OIDC_CLIENT_SECRET=
KNOTWORK_OIDC_REDIRECT_URL=http://localhost:8080/auth/callback

# Comma-separated emails that are always instance admins.
KNOTWORK_ADMIN_EMAILS=

# Optional S3-compatible backups. Leave bucket empty to back up to local disk.
KNOTWORK_S3_BUCKET=
KNOTWORK_S3_REGION=us-east-1
KNOTWORK_S3_ENDPOINT=
KNOTWORK_S3_ACCESS_KEY=
KNOTWORK_S3_SECRET_KEY=
KNOTWORK_S3_FORCE_PATH_STYLE=false

# Optional embedded CI.
KNOTWORK_DOCKER_HOST=unix:///var/run/docker.sock
KNOTWORK_BACKUP_INTERVAL=6h
KNOTWORK_BUNDLE_DEBOUNCE=30s

# Optional TLS termination in-process.
KNOTWORK_TLS_CERT=
KNOTWORK_TLS_KEY=

# Printed at startup when the instance has not been claimed yet.
KNOTWORK_SETUP_SECRET=

# stdio MCP only. Existing device-flow session token or instance JWT.
# Not read by `knotwork serve`. Never a user id.
# KNOTWORK_MCP_TOKEN=
